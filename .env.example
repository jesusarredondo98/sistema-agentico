# Ejemplo de entorno para desarrollo local (PRD §2.7).
# En AWS estas variables las inyecta Terraform; aqui sirven para ejecutar en local.
# La clave de Anthropic NUNCA va aqui: se lee del parametro SSM cuyo nombre es
# ANTHROPIC_API_KEY_PARAM (S-04).

AWS_REGION=us-east-1

ANTHROPIC_API_KEY_PARAM=/aeronova/anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5

MEMORY_TABLE=aeronova-memory
FLIGHTS_TABLE=aeronova-flights
RESERVATIONS_TABLE=aeronova-reservations

S3_BUCKET_LAKE=
RAG_CURRENT_POINTER=gold/rag/CURRENT
RAG_CONTRACT_VERSION_MIN=1.0.0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

MAX_TOOL_ROUNDS=3
MAX_OUTPUT_TOKENS=1024
HISTORY_WINDOW_MESSAGES=8
MEMORY_TTL_HOURS=24
RAG_TOP_K=4

LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aeronova-agent
